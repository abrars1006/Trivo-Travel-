# TRIVO-TRAVEL BACKEND CONFIGURATION
PORT=5000
NODE_ENV=development

# OpenAI API Key (Optional: when omitted, Trivo AI activates its built-in deterministic travel knowledge engine)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase PostgreSQL Configuration (Optional: when omitted, local session/token authentication and state management are used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Weather & Meteorological Service
# Trivo proxies and caches Open-Meteo (keyless, zero configuration needed).
# Alerts are cross-referenced with official IMD and NDMA advisories.
